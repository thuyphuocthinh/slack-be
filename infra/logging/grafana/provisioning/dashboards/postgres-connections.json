{
  "title": "Postgres — Connections (notification fan-out)",
  "uid": "postgres-connections",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "5s",
  "tags": ["postgres", "notification", "connections"],
  "panels": [
    {
      "id": 1,
      "title": "slack_db connections theo state",
      "description": "pg_stat_activity theo state (active/idle/idle in transaction/...) cho database slack_db. Nguồn: postgres-exporter (docker-compose.dev.yml), không sửa code app nào.",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "pg_stat_activity_count{datname=\"slack_db\"}",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Tổng connections slack_db (mọi state)",
      "description": "sum(pg_stat_activity_count{datname=\"slack_db\"}) — dùng để so với peak đã đo tay (109/126/169 ở N=1/10/30).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "sum(pg_stat_activity_count{datname=\"slack_db\"})",
          "legendFormat": "total connections",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 20 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 150 },
              { "color": "red", "value": 250 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "% max_connections đang dùng",
      "description": "sum(pg_stat_activity_count{datname=\"slack_db\"}) / scalar(pg_settings_max_connections) * 100. max_connections hiện = 300 (docker-compose.dev.yml).",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "sum(pg_stat_activity_count{datname=\"slack_db\"}) / scalar(pg_settings_max_connections) * 100",
          "legendFormat": "% used",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Postgres container — RAM",
      "description": "container_memory_usage_bytes{name=\"slack-postgres-dev\"} — nguồn cAdvisor (đã có sẵn, không thêm hạ tầng mới). So với baseline đã đo tay ~85MB idle, ~500MB peak ở N=30.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "container_memory_usage_bytes{name=\"slack-postgres-dev\"}",
          "legendFormat": "RAM",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 15 }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Postgres container — CPU %",
      "description": "rate(container_cpu_usage_seconds_total{name=\"slack-postgres-dev\"}[1m]) * 100 — % của 1 core, nguồn cAdvisor.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "rate(container_cpu_usage_seconds_total{name=\"slack-postgres-dev\"}[1m]) * 100",
          "legendFormat": "CPU %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "drawStyle": "line", "fillOpacity": 15 }
        },
        "overrides": []
      }
    }
  ]
}
