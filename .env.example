### GATEWAY PORT
GATEWAY_PORT=3000
SOCKET_PORT=3008
HOCUSPOCUS_PORT=8000
# Số worker cluster của api-gateway khi chạy local (1 là đủ cho dev).
GATEWAY_CLUSTER_WORKERS=1
API_GATEWAY_URL=http://localhost:3000/api/v1

### POSTGRES (docker-compose.dev.yml)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=slack_db
DB_SSL=false
DB_POOL_SIZE=50

### JWT
JWT_SECRET=replace-with-a-long-random-string

### MAIL (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM="Slack <your-email@gmail.com>"

### SENDGRID (optional alternative to SMTP)
SENDGRID_API_KEY=SG.your_api_key_here

### GOOGLE AUTH (OAuth2 login + Google Workspace integrations)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/callback/google

### REDIS (cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password

### CLOUDINARY (avatar/file uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

### CLOUDFLARE R2 (object storage)
R2_BUCKET_NAME=your-bucket
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=https://pub-xxxx.r2.dev

### BULLMQ (Redis instance dedicated to queues)
BULLMQ_HOST=127.0.0.1
BULLMQ_PORT=6380
BULLMQ_USERNAME=default
BULLMQ_PASSWORD=your-bullmq-redis-password

### LIVEKIT (video calls)
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=wss://your-project.livekit.cloud

### FRONTEND
FRONTEND_URL=http://localhost:5173

### CENTRALIZED LOGGING (Grafana Loki) — optional
LOKI_ENABLED=false
LOKI_HOST=http://localhost:3100

### TELEGRAM ALERTS — optional
TELEGRAM_ALERT_ENABLED=false
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

### STRIPE (billing)
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

### AI PROVIDERS
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_API_KEY=your-openai-api-key-for-embeddings

### AGENT OS / ORCHESTRATION
# AI_ROUTER_URL points at a self-hosted LLM router (e.g. 9router) that all
# LlmStrategy implementations call through instead of provider SDKs directly.
AI_ROUTER_URL=http://localhost:20128/v1
DEFAULT_REACT_MODEL=gpt-4o-mini
SUPERVISOR_MODEL=gpt-4o-mini
SUPERVISOR_EVALUATE_MODEL=gpt-4.1-nano
LOAD_TEST_MODE=false
ENABLE_CLARIFICATION_HITL=true

# MCP tool endpoints — each agent/provider's Model Context Protocol server.
AGENT_SQL_SERVER_URL=http://localhost:3018/mcp
AGENT_GITHUB_URL=http://localhost:3018/mcp/github
AGENT_GOOGLE_SHEETS_URL=http://localhost:3018/mcp/google_sheets
AGENT_GOOGLE_DOCS_URL=http://localhost:3018/mcp/google_docs
AGENT_GOOGLE_MAIL_URL=http://localhost:3018/mcp/google_mail
AGENT_GOOGLE_DRIVE_URL=http://localhost:3018/mcp/google_drive
AGENT_SLACK_URL=http://localhost:3018/mcp/slack
AGENT_NOTION_URL=http://localhost:3018/mcp/notion
AGENT_GOOGLE_CALENDAR_URL=http://localhost:3018/mcp/google_calendar
AGENT_COMPUTE_URL=http://localhost:3018/mcp/compute

# LangSmith tracing — optional, for debugging agent traces.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=slack-ai-agent

# mcp_auth — separate service that brokers per-user OAuth connections to
# external tools; slack-be registers itself as an "app" client against it.
MCP_AUTH_BASE_URL=http://localhost:3019
MCP_AUTH_CLIENT_ID=your-mcp-auth-client-id
MCP_AUTH_CLIENT_SECRET=your-mcp-auth-client-secret

# Shared secret between slack-be <-> mcp_server (must match on both sides).
MCP_SERVER_INTERNAL_API_KEY=your-shared-internal-api-key

### FIREBASE (push notifications)
VAPID_KEY=your-vapid-key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

### LINK PREVIEW SCRAPER — optional (Cloudflare Worker)
SCRAPER_WORKER_URL=https://your-worker.workers.dev/

### MICROSERVICES HOST & PORT (service discovery — defaults match docker-compose)
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=3001
USER_SERVICE_HOST=localhost
USER_SERVICE_PORT=3002
WORKSPACE_SERVICE_HOST=localhost
WORKSPACE_SERVICE_PORT=3003
CHANNEL_SERVICE_HOST=localhost
CHANNEL_SERVICE_PORT=3004
MESSAGE_SERVICE_HOST=localhost
MESSAGE_SERVICE_PORT=3005
TASK_SERVICE_HOST=localhost
TASK_SERVICE_PORT=3006
NOTIFICATION_SERVICE_HOST=localhost
NOTIFICATION_SERVICE_PORT=3007
VIDEO_CALL_SERVICE_HOST=localhost
VIDEO_CALL_SERVICE_PORT=3009
BILLING_SERVICE_HOST=localhost
BILLING_SERVICE_PORT=3010
INTEGRATIONS_SERVICE_HOST=localhost
INTEGRATIONS_SERVICE_PORT=3011
CANVAS_SERVICE_HOST=localhost
CANVAS_SERVICE_PORT=3012
CALENDAR_SERVICE_HOST=localhost
CALENDAR_SERVICE_PORT=3013
NOTE_SERVICE_HOST=localhost
NOTE_SERVICE_PORT=3016
EDGE_RELAY_PORT=3015

### NOTE (Hocuspocus realtime collab — separate WS server, not the TCP port above)
NOTE_HOCUSPOCUS_PORT=8081
# Dùng chung instance redis-cache — chỉ pub/sub cho multi-instance sync, không
# liên quan tới BullMQ (6380), không cần Redis riêng cho quy mô dự án này.
NOTE_HOCUSPOCUS_REDIS_HOST=127.0.0.1
NOTE_HOCUSPOCUS_REDIS_PORT=6379
NOTE_HOCUSPOCUS_REDIS_PASSWORD=your-redis-password
