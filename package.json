{
  "name": "slack-be",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:gateway": "nest build api-gateway",
    "build:auth": "nest build auth",
    "build:user": "nest build user",
    "build:workspace": "nest build workspace",
    "build:notification": "nest build notification",
    "build:billing": "nest build billing",
    "build:all": "pnpm build:gateway && pnpm build:auth && pnpm build:user && pnpm build:workspace && pnpm build:notification && pnpm build:billing",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api-gateway/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/slack-be/test/jest-e2e.json",
    "prepare": "husky",
    "start:gateway": "nest start api-gateway --watch",
    "start:auth": "nest start auth --watch",
    "start:user": "nest start user --watch",
    "start:workspace": "nest start workspace --watch",
    "start:notification": "nest start notification --watch",
    "start:channel": "nest start channel --watch",
    "start:task": "nest start task --watch",
    "start:message": "nest start message --watch",
    "start:socket-gateway": "nest start socket-gateway --watch",
    "start:video-call": "nest start video-call --watch",
    "start:billing": "nest start billing --watch",
    "start:integrations": "nest start integrations --watch",
    "start:nodeA": "cross-env NODE_OPTIONS='--max-old-space-size=4096' concurrently -n GATEWAY,AUTH,USER -c blue,green,pink \"pnpm run start:gateway\" \"pnpm run start:auth\" \"pnpm run start:user\"",
    "start:nodeB": "cross-env NODE_OPTIONS='--max-old-space-size=4096' concurrently -n WORKSPACE,NOTIFICATION -c yellow,cyan \"pnpm run start:workspace\" \"pnpm run start:notification\"",
    "start:all": "cross-env NODE_OPTIONS='--max-old-space-size=4096' concurrently -n GATEWAY,AUTH,USER,WORKSPACE,NOTIFICATION,CHANNEL,TASK,MESSAGE,SOCKET,VIDEO,BILLING,INTEGRATIONS -c blue,green,pink,yellow,cyan,magenta,red,white,gray,black,bgBlue,white \"pnpm run start:gateway\" \"pnpm run start:auth\" \"pnpm run start:user\" \"pnpm run start:workspace\" \"pnpm run start:notification\" \"pnpm run start:channel\" \"pnpm run start:task\" \"pnpm run start:message\" \"pnpm run start:socket-gateway\" \"pnpm run start:video-call\" \"pnpm run start:billing\" \"pnpm run start:integrations\"",
    "type-check": "tsc --noEmit",
    "typeorm": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "pnpm typeorm migration:generate -d ./data-source.ts",
    "migration:run": "pnpm typeorm migration:run -d ./data-source.ts",
    "migration:revert": "pnpm typeorm migration:revert -d ./data-source.ts"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.3.4",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.19",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/swagger": "^11.3.0",
    "@nestjs/typeorm": "^11.0.1",
    "@nestjs/websockets": "^11.1.19",
    "@sendgrid/mail": "^8.1.6",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.44.0",
    "axios": "^1.16.1",
    "bullmq": "^5.76.1",
    "camelcase-keys": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.9.0",
    "dotenv": "^17.4.2",
    "handlebars": "^4.7.9",
    "ioredis": "^5.10.1",
    "joi": "^18.1.2",
    "livekit-server-sdk": "^2.15.3",
    "lodash": "^4.18.1",
    "nanoid": "^5.1.9",
    "nest-winston": "^1.10.2",
    "nodemailer": "^8.0.5",
    "opossum": "^9.0.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "stripe": "^22.2.0",
    "typeorm": "^0.3.28",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.4",
    "winston-transport": "^4.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.26",
    "@types/axios": "^0.14.4",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/opossum": "^8.1.9",
    "@types/supertest": "^6.0.2",
    "autocannon": "^8.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@slack/cached(|/.*)$": "<rootDir>/libs/cached/src/$1",
      "^@slack/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@slack/constants(|/.*)$": "<rootDir>/libs/constants/src/$1",
      "^@slack/database(|/.*)$": "<rootDir>/libs/database/src/$1",
      "^@slack/queue(|/.*)$": "<rootDir>/libs/queue/src/$1"
    }
  }
}